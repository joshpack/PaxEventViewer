<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdEventViewer</RootNamespace>
    <AssemblyName>pxdEventViewer</AssemblyName>
    <Version>1.1.2</Version>
    <Product>pxd Event Viewer</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered by the app's write-icon option (see README); a fresh clone builds without it. -->
    <ApplicationIcon Condition="Exists('Assets\pxdEventViewer.ico')">Assets\pxdEventViewer.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Only for the self-test: renders the window without creating one on the screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <Target Name="TrimPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
